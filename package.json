{
  "name": "find-public-health-data",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.18.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build && pnpm check:artefacts",
    "check:artefacts": "pnpm --filter @fphd/artefact-boundary run check:artefacts",
    "check:write": "biome check --write .",
    "db:generate": "pnpm --filter @fphd/config build && pnpm --filter @fphd/db db:generate",
    "db:import-topics": "pnpm --filter @fphd/config build && pnpm --filter @fphd/db db:import-topics",
    "db:migrate": "pnpm --filter @fphd/config build && pnpm --filter @fphd/db db:migrate",
    "db:rebuild-read-models": "pnpm --filter @fphd/config build && pnpm --filter @fphd/db db:rebuild-read-models",
    "db:seed": "pnpm --filter @fphd/config build && pnpm --filter @fphd/db db:seed",
    "db:studio": "pnpm --filter @fphd/config build && pnpm --filter @fphd/db db:studio",
    "dev": "pnpm --recursive --parallel run dev",
    "dev:internal": "pnpm --parallel --filter @fphd/internal-web --filter @fphd/internal-api run dev",
    "dev:mixed": "scripts/dev.sh",
    "dev:public": "pnpm --parallel --filter @fphd/public-web --filter @fphd/public-api run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:e2e": "pnpm --recursive run --if-present test:e2e",
    "test:integration": "cross-env INTEGRATION_DB=1 vitest run --passWithNoTests integration.test",
    "test:unit": "vitest run --exclude '**/*integration.test.*'",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fphd/db": "workspace:*",
    "@react-router/dev": "catalog:",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
