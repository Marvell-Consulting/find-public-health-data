# Local development environment. Copy to `.env` and adjust as needed.
# `.env` is gitignored; this example is committed.
# The dev scripts load this file automatically (--env-file-if-exists); in deployed
# environments every value is injected by the platform instead.

# Deployment environment: local | test | dev | preview | production. Required, with no
# default anywhere: every fallback keyed off it relaxes something when the environment is
# this machine, so an unset value must not be allowed to pick that silently. `test` is set
# by the test scripts, not here.
APP_ENV=local

# Per-app listen address and port. Defaults: host 0.0.0.0; public-web 3000,
# internal-web 3001, public-api 4000, internal-api 4001. A PORT set here applies to
# every app that loads this file, so leave it unset unless you are running one app.
#HOST=0.0.0.0
#PORT=4000

# Base URL each web app's server uses to call its API. Defaults: public-web
# http://localhost:4000, internal-web http://localhost:4001.
#API_URL=http://localhost:4000

# How long a server keeps serving after SIGTERM before it closes anything, giving the ingress
# time to see readiness fail and stop routing to it. Defaults to 0 where nothing routes to the
# process (APP_ENV local or test) and 5000 elsewhere. Comes out of the budget below, so it must
# be under it.
#SHUTDOWN_DRAIN_MS=5000

# The budget for a whole stop, drain included (default 25000). It is a ceiling, not a wait: a
# stop with nothing in flight is immediate. Keep it under the platform's own grace period —
# Container Apps allows 30s by default — and raise the two together, never this one alone.
#SHUTDOWN_GRACE_PERIOD_MS=25000

# Logging. LOG_LEVEL: fatal | error | warn | info | debug | trace (default info).
# Pretty printing applies only when APP_ENV is local (on by default; LOG_PRETTY=0 disables).
# Deployed environments always log JSON.
#LOG_LEVEL=info
#LOG_PRETTY=0

# Signs JWT session cookies issued by the authentication backend. This value is for local
# development only; inject a different secret of at least 32 bytes into each deployed service.
SESSION_JWT_SECRET=fphd-local-development-jwt-secret-change-before-deploying

# Signs each web app's own cookie session, which today carries flash messages across a
# redirect. Separate from SESSION_JWT_SECRET so the two rotate independently. Local value
# only; at least 32 bytes.
WEB_SESSION_SECRET=fphd-local-development-web-session-secret-change-before-deploying

# Database connection, shared by all roles.
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=fphd

# TLS to the database. Left unset it follows APP_ENV: off for local and test, where the
# database is the compose container and presents no certificate, and on everywhere else,
# which is what a managed server requires. Certificates are verified against Node's CA
# store, so setting this is not a way to accept an unknown one. It exists to override the
# default in a deployed environment; against the compose database the only value that
# connects is off.
#DB_TLS=1

# Owner role — used by the Postgres container and by drizzle-kit for migrations.
POSTGRES_USER=fphd
POSTGRES_PASSWORD=fphd

# Per-API role passwords (role names are fixed: public_api / internal_api).
# Single source of truth: `pnpm db:bootstrap` creates the roles with these, and each
# API connects with them.
PUBLIC_API_PASSWORD=public_api
INTERNAL_API_PASSWORD=internal_api
